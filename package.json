{
  "name": "vplayer-extension",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/browser.mjs && node tests/episodes-browser.mjs",
    "check": "npm test && npm run build && npm run test:e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@videojs/hlsjs-video": "10.4.0",
    "@videojs/html": "10.4.0",
    "hls.js": "^1.7.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1"
  },
  "overrides": {
    "hls.js": "$hls.js"
  }
}
